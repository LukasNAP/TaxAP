# Public URL used by browsers and accepted by the connector's same-origin CORS check.
# Change this once Atlantic assigns TaxAP's permanent internal DNS name.
TAXAP_ALLOWED_ORIGIN=https://apdock01.atlanticpkg.com:5017
TAXAP_HTTPS_PORT=5017

# Read-only Azure SQL / DWStage settings. Never place a user password or access token here.
TAXAP_SQL_SERVER=sql04-az.a5ef7ddec742.database.windows.net
TAXAP_SQL_DATABASE=DWStage
TAXAP_SQL_LINKED_SERVER=SQL03
TAXAP_APLUS_LINKED_SERVER=APLUS
TAXAP_APLUS_LIBRARY=APLUSV8FAQ

# DefaultAzureCredential uses an Entra service principal with a PEM certificate that includes its private key.
# The certificate stays only on apdock01 at secrets/azure-sql-client-cert.pem and is mounted read-only in the container.
# Do not use a personal `az login`, access token, SQL password, or client secret.
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_CERTIFICATE_PATH=/run/secrets/azure-sql-client-cert.pem

# Approved certificate paths on apdock01. These are host paths, not certificate contents.
TAXAP_TLS_CERT_PATH=
TAXAP_TLS_KEY_PATH=

# User sign-in only: separate registration from the AZURE_* SQL workload identity above.
# Register this Web redirect URI in Entra: <TAXAP_ALLOWED_ORIGIN>/oauth2/callback
# Current URI: https://apdock01.atlanticpkg.com:5017/oauth2/callback
TAXAP_SIGNIN_TENANT_ID=
TAXAP_SIGNIN_CLIENT_ID=
# Security group object ID; configure the groups claim in ID tokens.
TAXAP_SIGNIN_GROUP_ID=
# Protected host file paths only. Provision contents securely, outside the checkout.
# Client-secret file: secret value with no newline. Cookie-secret file: 32 raw random bytes.
TAXAP_SIGNIN_CLIENT_SECRET_FILE=/var/atlanticapps/taxap/secrets/signin-client-secret
TAXAP_SIGNIN_COOKIE_SECRET_FILE=/var/atlanticapps/taxap/secrets/signin-cookie-secret
