# Use "entra" for Azure SQL through DefaultAzureCredential, or "windows" for a direct
# local SQL Server connection using the current Windows account. Never store a password here.
TAXAP_SQL_AUTHENTICATION=entra
# For a dedicated SQL login, use authentication=sql and a protected password file.
# TAXAP_SQL_USER=
# TAXAP_SQL_PASSWORD_FILE=
# TAXAP_SQL_PORT=1433
# Explicit IT-approved exception for SQL-login mode; encryption remains enabled.
# TAXAP_SQL_TRUST_SERVER_CERTIFICATE=false
TAXAP_SQL_SERVER=your-server.database.windows.net
TAXAP_SQL_DATABASE=DWStage
TAXAP_SQL_LINKED_SERVER=SQL03
TAXAP_APLUS_LINKED_SERVER=APLUS
TAXAP_APLUS_LIBRARY=APLUSV8FAQ
TAXAP_CONNECTOR_HOST=127.0.0.1
TAXAP_CONNECTOR_PORT=3001
TAXAP_ALLOWED_ORIGIN=http://localhost:3000

# Optional local fallback for NY PDF extraction when pdftotext is not on PATH.
# Set an absolute Python executable with pdfplumber installed in .env.local, then restart.
# TAXAP_PYTHON_PATH=
